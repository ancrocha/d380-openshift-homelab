# Managed by Ansible - tasks/configure-dhcp.yaml
option domain-name "{{ lab_domain }}";
option domain-name-servers {{ dns_server_ip }};
option domain-search "{{ lab_domain }}";

default-lease-time {{ dhcp_lease_time }};
max-lease-time {{ dhcp_max_lease_time }};

# this server is the only DHCP server of the OCP network
authoritative;

subnet {{ lab_subnet }} netmask {{ lab_netmask }} {
    range {{ dhcp_range_start }} {{ dhcp_range_end }};
    option routers {{ lab_gateway }};
    option subnet-mask {{ lab_netmask }};
    option broadcast-address {{ lab_broadcast }};
}

{% for host in dhcp_reservations %}
host {{ host.name }} {
    hardware ethernet {{ host.mac }};
    fixed-address {{ host.ip }};
    option host-name "{{ host.name }}.{{ lab_domain }}";
}
{% endfor %}
