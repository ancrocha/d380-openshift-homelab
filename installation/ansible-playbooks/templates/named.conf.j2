// Managed by Ansible - tasks/configure-dns.yaml
options {
    listen-on port 53 { 127.0.0.1; {{ dns_server_ip }}; };
    listen-on-v6 { none; };
    directory          "/var/named";
    dump-file          "/var/named/data/cache_dump.db";
    statistics-file    "/var/named/data/named_stats.txt";
    memstatistics-file "/var/named/data/named_mem_stats.txt";

    allow-query { localhost; {% for net in dns_allow_query %}{{ net }}; {% endfor %}};
    recursion yes;
    forwarders { {% for server in lab_upstream_dns %}{{ server }}; {% endfor %}};
    dnssec-validation no;
};

logging {
    channel default_debug {
        file "data/named.run";
        severity dynamic;
    };
};

zone "." IN {
    type hint;
    file "named.ca";
};

zone "{{ lab_domain }}" IN {
    type master;
    file "{{ lab_domain }}.zone";
    allow-update { none; };
};

zone "{{ dns_reverse_zone }}" IN {
    type master;
    file "{{ dns_reverse_zone }}.zone";
    allow-update { none; };
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";
